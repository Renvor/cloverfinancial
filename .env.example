# SmartTrade AI example configuration.
# Copy this file to ".env" if you want to change defaults. Nothing here is required.
# The application runs fully without any of these values.

# Where the local SQLite database and imported files live (default: ./data)
SMARTTRADE_DATA_DIR=./data

# Web server bind address and port
SMARTTRADE_HOST=127.0.0.1
SMARTTRADE_PORT=8000

# Logging level: DEBUG, INFO, WARNING, ERROR
SMARTTRADE_LOG_LEVEL=INFO

# Allow the optional free network data providers (Stooq for stocks/ETFs,
# CoinGecko for crypto). They need no API keys but do need internet access.
# Set to "false" to run fully offline.
SMARTTRADE_ENABLE_NETWORK_PROVIDERS=true

# Optional provider API keys (NOT required). Leave blank to keep them disabled.
# These are placeholders for future optional integrations only.
ALPHAVANTAGE_API_KEY=
